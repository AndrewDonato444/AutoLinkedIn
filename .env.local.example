# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.

# ----------------------------------------------------------
# GojiBerry AI
# ----------------------------------------------------------
GOJIBERRY_API_KEY=your_gojiberry_api_key_here
GOJIBERRY_API_URL=https://ext.gojiberry.ai
GOJIBERRY_MCP_URL=https://mcp.gojiberry.ai

# ----------------------------------------------------------
# Automation Settings
# ----------------------------------------------------------
DAILY_LEAD_SCAN_LIMIT=10
MIN_INTENT_SCORE=50
ICP_DESCRIPTION=

# ----------------------------------------------------------
# Scheduling
# ----------------------------------------------------------
DAILY_SCAN_CRON="0 7 * * 1-5"
WEEKLY_REPORT_CRON="0 8 * * 1"

# ----------------------------------------------------------
# Build Loop Configuration (optional — for spec-driven builds)
# ----------------------------------------------------------
CLI_PROVIDER=claude
MAX_FEATURES=15
MAX_RETRIES=3
BRANCH_STRATEGY=sequential

SPEC_MODEL=claude-opus-4-6
BUILD_MODEL=claude-sonnet-4-6
REFACTOR_MODEL=claude-sonnet-4-6
RETRY_MODEL=claude-sonnet-4-6
DRIFT_MODEL=claude-sonnet-4-6
COMPOUND_MODEL=claude-sonnet-4-6

DRIFT_CHECK=true
MAX_DRIFT_RETRIES=2
REFACTOR=true
COMPOUND=true

BUILD_CHECK_CMD=npx tsc --noEmit
TEST_CHECK_CMD=npm test
LINT_CHECK_CMD=skip
MIGRATION_CMD=skip
E2E_CHECK_CMD=skip

# Transient error handling
RATE_LIMIT_BACKOFF=60
RATE_LIMIT_MAX_WAIT=18000
